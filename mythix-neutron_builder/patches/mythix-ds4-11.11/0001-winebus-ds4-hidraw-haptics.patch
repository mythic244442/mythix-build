+    /* For Sony controllers, build the descriptor once with proper haptics appended */
+    if (impl->is_sony && !impl->sony_haptics_ready)
+    {
+        if (ioctl(impl->base.device_fd, HIDIOCGRDESCSIZE, &descriptor.size) == -1)
+        {
+            WARN("ioctl(HIDIOCGRDESCSIZE) failed: %d %s\n", errno, strerror(errno));
+            return STATUS_UNSUCCESSFUL;
+        }
+        if (descriptor.size && ioctl(impl->base.device_fd, HIDIOCGRDESC, &descriptor) == -1)
+        {
+            WARN("ioctl(HIDIOCGRDESC) failed: %d %s\n", errno, strerror(errno));
+            return STATUS_UNSUCCESSFUL;
+        }
+
+        /* Insert haptics inside the FIRST Application collection (gamepad).
+         * The DS4 descriptor has multiple top-level collections; xinput only
+         * opens the gamepad one, so haptics must live there. */
+        {
+            int split = find_first_app_collection_end(descriptor.value, descriptor.size);
+            if (split < 0)
+            {
+                WARN("Could not find gamepad Application collection end\n");
+                if (!hidraw_desc_seed(&iface->hid_report_descriptor,
+                                      descriptor.value, descriptor.size))
+                    return STATUS_NO_MEMORY;
+                /* no axis remap — game handles DS4 axes natively */
+            }
+            else
+            {
+                static const BYTE end_coll[] = {0xc0};
+                BYTE max_id = 0;
+                /* bytes before the first app-collection's closing 0xc0 */
+                if (!hidraw_desc_seed(&iface->hid_report_descriptor,
+                                      descriptor.value, split))
+                    return STATUS_NO_MEMORY;
+                /* Override next_report_id with scan of FULL hardware descriptor
+                 * so haptics IDs don't collide with ANY collection. */
+                for (SIZE_T ri = 0; ri + 1 < descriptor.size; ri++)
+                {
+                    if (descriptor.value[ri] == 0x85)
+                    {
+                        if (descriptor.value[ri + 1] > max_id) max_id = descriptor.value[ri + 1];
+                        ri++;
+                    }
+                }
+                iface->hid_report_descriptor.next_report_id[0] = max_id + 1;
+                iface->hid_report_descriptor.next_report_id[1] = max_id + 1;
+                iface->hid_report_descriptor.next_report_id[2] = max_id + 1;
+                /* haptics goes inside the gamepad collection */
+                if (!hid_device_add_haptics(iface))
+                    return STATUS_NO_MEMORY;
+                /* close the first app collection */
+                if (!hidraw_desc_append(&iface->hid_report_descriptor, end_coll, 1))
+                    return STATUS_NO_MEMORY;
+                /* append remaining collections (vendor-specific, audio, etc.) */
+                if (split + 1 < (int)descriptor.size)
+                {
+                    if (!hidraw_desc_append(&iface->hid_report_descriptor,
+                                            descriptor.value + split + 1,
+                                            descriptor.size - split - 1))
+                        return STATUS_NO_MEMORY;
+                }
+            }
+        }
+
+        impl->sony_haptics_ready = TRUE;
+    }
+
+    if (impl->is_sony)
