+#define SONY_VID 0x054c
+
+/* DS4/DualSense HID descriptors use non-standard axis assignments:
+ *   Z/Rz for right stick, Rx/Ry for triggers
+ * but winexinput expects the XInput-standard layout:
+ *   Rx/Ry for right stick, Z/Rz for triggers
+ * Swap the usage bytes in the raw descriptor so the mapping is correct. */
+static void remap_sony_axes(BYTE *data, SIZE_T size)
+{
+    BYTE usage_page = 0;
+    SIZE_T i = 0;
+    while (i < size)
+    {
+        BYTE b = data[i];
+        int bsize = b & 0x03;
+        int btype = (b >> 2) & 0x03;
+        int btag = (b >> 4) & 0x0F;
+        if (bsize == 3) bsize = 4;
+        if (btype == 1 && btag == 0 && bsize >= 1)
+            usage_page = data[i + 1];
+        if (btype == 2 && btag == 0 && bsize >= 1 && usage_page == 0x01)
+        {
+            switch (data[i + 1])
+            {
+            case 0x32: data[i + 1] = 0x33; break; /* Z  → Rx (right stick X) */
+            case 0x33: data[i + 1] = 0x32; break; /* Rx → Z  (left trigger)  */
+            case 0x34: data[i + 1] = 0x35; break; /* Ry → Rz (right trigger) */
+            case 0x35: data[i + 1] = 0x34; break; /* Rz → Ry (right stick Y) */
+            }
+        }
+        i += 1 + bsize;
+    }
+}
+
+static BOOL hidraw_desc_append(struct hid_report_descriptor *desc, const BYTE *data, SIZE_T size)
+{
+    if (desc->size + size > desc->max_size)
+    {
+        SIZE_T new_max = desc->max_size * 3 / 2;
+        BYTE *tmp;
+        if (new_max < desc->size + size) new_max = desc->size + size;
+        tmp = realloc(desc->data, new_max);
+        if (!tmp) return FALSE;
+        desc->data = tmp;
+        desc->max_size = new_max;
+    }
+    memcpy(desc->data + desc->size, data, size);
+    desc->size += size;
+    return TRUE;
+}
+
+static BOOL hidraw_desc_seed(struct hid_report_descriptor *desc, const BYTE *data, SIZE_T size)
+{
+    BYTE *tmp = realloc(desc->data, size);
+    if (!tmp) return FALSE;
+    memcpy(tmp, data, size);
+    desc->data = tmp;
+    desc->size = size;
+    desc->max_size = size;
+
+    BYTE max_id = 0;
+    for (SIZE_T i = 0; i + 1 < size; i++)
+    {
+        if (data[i] == 0x85)
+        {
+            if (data[i + 1] > max_id) max_id = data[i + 1];
+            i++;
+        }
+    }
+    desc->next_report_id[0] = max_id + 1;
+    desc->next_report_id[1] = max_id + 1;
+    desc->next_report_id[2] = max_id + 1;
+
+    return TRUE;
+}
+
+/* Find the closing 0xc0 of the FIRST Application collection in a HID
+ * descriptor.  Returns the byte offset, or -1 on failure. */
+static int find_first_app_collection_end(const BYTE *desc, SIZE_T size)
+{
+    SIZE_T i = 0;
+    int depth = 0;
+    BOOL found_app = FALSE;
+
+    while (i < size)
+    {
+        BYTE b = desc[i];
+
+        if (b == 0xfe && i + 2 < size)      /* long item */
+        {
+            i += 3 + desc[i + 1];
+            continue;
+        }
+
+        int item_size = b & 0x03;
+        if (item_size == 3) item_size = 4;   /* HID encoding: 3 → 4 bytes */
+
+        if (b == 0xa1 && i + 1 < size)       /* COLLECTION(type) */
+        {
+            if (depth == 0 && desc[i + 1] == 0x01)
+                found_app = TRUE;
+            depth++;
+        }
+        else if (b == 0xc0)                  /* END_COLLECTION */
+        {
+            depth--;
+            if (found_app && depth == 0)
+                return (int)i;
+        }
+
+        i += 1 + item_size;
+    }
+    return -1;
+}
