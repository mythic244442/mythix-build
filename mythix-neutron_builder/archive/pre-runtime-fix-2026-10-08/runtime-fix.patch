diff --git a/neutron-customization.cfg b/neutron-customization.cfg
index 7964d1d..30ff943 100644
--- a/neutron-customization.cfg
+++ b/neutron-customization.cfg
@@ -79,6 +79,12 @@ export _configure_args=(
     # OSS: outdated audio system; Proton uses ALSA/PulseAudio/PipeWire
     "--without-oss"
 
+    # libunwind: without it Wine's x86_64 ntdll.so uses its own DWARF unwinder
+    # (via libgcc_s), which is how Valve builds Proton. With it, ntdll.so links
+    # libunwind.so.8 — which no Steam Linux Runtime ships — so Wine can't start
+    # inside the container at all ("wine: could not load ntdll.so").
+    "--without-unwind"
+
     # ── Optional: disable ffmpeg to reduce dependency surface.
     # Re-enable if you need Wine's built-in video codec support:
     #   remove the line below and add "--with-ffmpeg"
diff --git a/neutron.py b/neutron.py
index c6b76cf..af53fe7 100644
--- a/neutron.py
+++ b/neutron.py
@@ -752,7 +752,13 @@ class Neutron:
                 env["WINEBOOT"] = self.wineboot
                 env["WINESERVER"] = self.wineserver
                 env["PATH"] = self.bin_dir + ":" + os.environ.get("PATH", "")
-                env["LD_LIBRARY_PATH"] = self.lib_dir
+                # Our libs first, then whatever we inherited: inside a Steam
+                # Linux Runtime container that's pressure-vessel's paths plus
+                # host libraries the launcher bridged in (Mythix Launcher's
+                # MYTHIX_RUNTIME_LIBRARY_PATH) — without them wineboot can't
+                # load ntdll.so there and template creation dies.
+                env["LD_LIBRARY_PATH"] = ":".join(
+                    p for p in (self.lib_dir, os.environ.get("LD_LIBRARY_PATH", "")) if p)
                 env["WINEDEBUG"] = "-all"
                 makedirs(temp)
                 log(f"creating default prefix template ({temp})")
