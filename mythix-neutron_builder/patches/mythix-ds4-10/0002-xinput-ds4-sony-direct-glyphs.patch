     HANDLE device;
@@ -449,6 +553,10 @@ static BOOL open_device_at_index(const WCHAR *device_path, int index)
                          NULL, OPEN_EXISTING, FILE_FLAG_OVERLAPPED | FILE_FLAG_NO_BUFFERING, NULL);
     if (device == INVALID_HANDLE_VALUE) return TRUE;
 
+    if (!HidD_GetAttributes(device, &attr)) attr.VendorID = attr.ProductID = 0;
