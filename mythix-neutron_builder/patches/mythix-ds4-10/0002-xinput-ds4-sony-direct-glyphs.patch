+/* Mythix DualShock 4 (Luna's Neutron xinput, carried to the proton_10.0 tree).
+ *
+ * MYTHIX_DS4_GLYPHS=1 is native PlayStation mode: a Sony pad never shows up in
+ * XInputGetState(Ex) or XInputGetKeystroke, so games with native PlayStation
+ * support read it over HID and show PlayStation glyphs. XInput still has the
+ * pad open, so XInputGetCapabilities succeeds and XInputSetState rumbles it
+ * (Cyberpunk 2077 drives vibration through XInput).
+ *
+ * Sony direct path: winebus keeps a DS4 / DualSense on hidraw as a plain HID
+ * device, so no WINEXINPUT interface exists for it. When XInput slot 0 is
+ * empty, the first Sony gamepad collection is opened there instead; its input
+ * reports keep the pad's own layout. */
+#define SONY_VID 0x054c
+
+static BOOL check_sony_glyph_mode(void)
+{
+    static BOOL checked, enabled;
+
+    if (!checked)
+    {
+        const char *val = getenv("MYTHIX_DS4_GLYPHS");
+        enabled = val && val[0] == '1';
+        checked = TRUE;
+    }
+    return enabled;
+}
+
+static BOOL is_dualsense(WORD pid)
+{
+    return pid == 0x0ce6 || pid == 0x0df2;
+}
+
+static const WORD sony_dpad[8] =
+{
+    XINPUT_GAMEPAD_DPAD_UP,
+    XINPUT_GAMEPAD_DPAD_UP | XINPUT_GAMEPAD_DPAD_RIGHT,
+    XINPUT_GAMEPAD_DPAD_RIGHT,
+    XINPUT_GAMEPAD_DPAD_DOWN | XINPUT_GAMEPAD_DPAD_RIGHT,
+    XINPUT_GAMEPAD_DPAD_DOWN,
+    XINPUT_GAMEPAD_DPAD_DOWN | XINPUT_GAMEPAD_DPAD_LEFT,
+    XINPUT_GAMEPAD_DPAD_LEFT,
+    XINPUT_GAMEPAD_DPAD_UP | XINPUT_GAMEPAD_DPAD_LEFT,
+};
+
+/* input report 0x01; winebus turns the Bluetooth reports into the same layout */
+static BOOL DS4_get_state(struct xinput_controller *controller, const BYTE *buf, ULONG len, XINPUT_STATE *state)
+{
+    const BYTE *sticks = buf + 1, *buttons, *triggers;
+
+    if (len < 11 || buf[0] != 0x01) return FALSE;
+    if (is_dualsense(controller->product_id)) buttons = buf + 8, triggers = buf + 5;
+    else buttons = buf + 5, triggers = buf + 8;
+
+    memset(&state->Gamepad, 0, sizeof(state->Gamepad));
+    state->Gamepad.sThumbLX = (SHORT)(((int)sticks[0] - 128) << 8);
+    state->Gamepad.sThumbLY = (SHORT)((127 - (int)sticks[1]) << 8);
+    state->Gamepad.sThumbRX = (SHORT)(((int)sticks[2] - 128) << 8);
+    state->Gamepad.sThumbRY = (SHORT)((127 - (int)sticks[3]) << 8);
+    state->Gamepad.bLeftTrigger = triggers[0];
+    state->Gamepad.bRightTrigger = triggers[1];
+
+    if ((buttons[0] & 0x0f) < 8) state->Gamepad.wButtons |= sony_dpad[buttons[0] & 0x0f];
+    if (buttons[0] & 0x10) state->Gamepad.wButtons |= XINPUT_GAMEPAD_X;     /* square */
+    if (buttons[0] & 0x20) state->Gamepad.wButtons |= XINPUT_GAMEPAD_A;     /* cross */
+    if (buttons[0] & 0x40) state->Gamepad.wButtons |= XINPUT_GAMEPAD_B;     /* circle */
+    if (buttons[0] & 0x80) state->Gamepad.wButtons |= XINPUT_GAMEPAD_Y;     /* triangle */
+    if (buttons[1] & 0x01) state->Gamepad.wButtons |= XINPUT_GAMEPAD_LEFT_SHOULDER;
+    if (buttons[1] & 0x02) state->Gamepad.wButtons |= XINPUT_GAMEPAD_RIGHT_SHOULDER;
+    if (buttons[1] & 0x10) state->Gamepad.wButtons |= XINPUT_GAMEPAD_BACK;  /* share / create */
+    if (buttons[1] & 0x20) state->Gamepad.wButtons |= XINPUT_GAMEPAD_START; /* options */
+    if (buttons[1] & 0x40) state->Gamepad.wButtons |= XINPUT_GAMEPAD_LEFT_THUMB;
+    if (buttons[1] & 0x80) state->Gamepad.wButtons |= XINPUT_GAMEPAD_RIGHT_THUMB;
+    if (buttons[2] & 0x01) state->Gamepad.wButtons |= XINPUT_GAMEPAD_GUIDE; /* PS */
+    return TRUE;
+}
+
+/* native DS4 rumble (USB output report 0x05), for a Sony direct pad whose
+ * descriptor has no haptics collection to go through winebus */
+static DWORD DS4_set_state(struct xinput_controller *controller, XINPUT_VIBRATION *state)
+{
+    ULONG report_len = controller->hid.caps.OutputReportByteLength;
+    BYTE *report_buf = (BYTE *)controller->hid.output_report_buf;
+    BOOL update = memcmp(&controller->vibration, state, sizeof(*state));
+
+    controller->vibration = *state;
+    if (!controller->enabled || !update || report_len < 32) return ERROR_SUCCESS;
+
+    memset(report_buf, 0, report_len);
+    report_buf[0] = 0x05;
+    report_buf[1] = 0x01;   /* motors only, leave the lightbar to the game */
+    report_buf[4] = state->wRightMotorSpeed >> 8;
+    report_buf[5] = state->wLeftMotorSpeed >> 8;
+    if (!HidD_SetOutputReport(controller->device, report_buf, report_len))
+        WARN("DS4 rumble report failed, error %lu\n", GetLastError());
+    return ERROR_SUCCESS;
+}
