# ── Build artifacts ───────────────────────────────────────────────────────────
# Generated by mythix-wine_builder and mythix-neutron_builder during builds.
# These can be many GB — never commit them.
mythix-wine_builder/buildz/
mythix-wine_builder/src/
mythix-neutron_builder/buildz/
mythix-neutron_builder/src/

# ── Debug / scratch files ─────────────────────────────────────────────────────
debug-*.txt
*.log

# ── User config ───────────────────────────────────────────────────────────────
# winetoolz user config lives at ~/.config/mythix-build/winetoolz.cfg
# The _config file at the project root is a personal leftover — ignore it.
_config
mythix-winetoolz/_config

# ── Editor / OS noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.vscode/
.idea/

# ── Python cache + build artefacts ────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/
