@@ -490,8 +598,12 @@ static BOOL find_opened_device(const WCHAR *device_path, int *free_slot)
          swscanf(device_path, L"\\\\?\\HID#VID_28DE&PID_11FF&XI_%02u#", &i) == 1) &&
